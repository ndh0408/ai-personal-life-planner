# =============================================================================
# LifeOS AI — backend production environment (docker-compose.production.yml).
# Copy to .env.production and fill in. DO NOT COMMIT the real file.
# =============================================================================

# ---- Postgres (used by the postgres container + DATABASE_URL below) --------
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Prisma connection string. `postgres` is the docker service name.
# IMPORTANT: pin `connection_limit` so Prisma doesn't blow past Postgres
# max_connections when you run multiple API replicas. Rule of thumb:
#   connection_limit ≤ (max_connections - 10) / replicas
# At a default Postgres `max_connections=100` and 2 replicas, use 40. See
# docs/ENTERPRISE_SCALE_SECURITY_AUDIT.md §11 for the math.
DATABASE_URL=postgresql://lifeos:change-me-to-a-long-random-string@postgres:5432/lifeos?schema=public&connection_limit=10&pool_timeout=20

# ---- JWT --------------------------------------------------------------------
# Generate with `openssl rand -base64 48` — two independent secrets.
JWT_ACCESS_SECRET=replace-with-48-bytes-base64
JWT_REFRESH_SECRET=replace-with-different-48-bytes-base64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- AI provider ------------------------------------------------------------
# AI_PROVIDER: mock | anthropic | openai
# Server-side only. The mobile client never sees this key — verified by bundle scan.
AI_PROVIDER=anthropic
AI_API_KEY=replace-with-real-key
AI_MODEL=claude-opus-4-7

# ---- BYOK (Bring-Your-Own-Key) — REQUIRED in production --------------------
# Symmetric key for encrypting per-user AI provider API keys at rest.
# Generate via: openssl rand -hex 32  (64 hex chars = 32 bytes).
# The API REFUSES to start if this is missing or shorter than 32 chars.
# Rotating invalidates ALL stored user keys (they must re-enter). See
# docs/USER_AI_PROVIDERS.md for the rotation procedure.
AI_PROVIDER_ENCRYPTION_KEY=

# OpenRouter attribution headers (optional, only used when a user picks
# OpenRouter as their BYOK provider).
# OPENROUTER_HTTP_REFERER=https://app.yourdomain.com
# OPENROUTER_X_TITLE=LifeOS AI

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins. Use the mobile build's HTTPS origin
# plus any web surfaces (web admin, landing). The API REFUSES to start in
# production if this is empty or "*" — mobile-only deployments can set this to
# any HTTPS origin you control (mobile clients do not send Origin headers).
CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com

# ---- Locale -----------------------------------------------------------------
DEFAULT_LOCALE=vi
SUPPORTED_LOCALES=vi,en

# ---- Redis + queue (round 12) -----------------------------------------------
# QUEUE_ENABLED switches notification dispatcher + BullMQ workers + Redis-
# backed throttler ON. Production should always be true. Setting false makes
# enqueue() a no-op (notifications written but never sent).
QUEUE_ENABLED=true
REDIS_URL=redis://redis:6379

# Worker concurrency per replica. Bump if a single replica is under-utilised.
WORKER_CONCURRENCY_NOTIFICATION=5
WORKER_CONCURRENCY_AI=2
WORKER_CONCURRENCY_REPORT=2

# ---- Observability (round 12) -----------------------------------------------
# /metrics is gated behind METRICS_ENABLED. When enabled, set a long random
# bearer token so only the Prometheus scrape can read it.
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_BEARER_TOKEN=
LOG_LEVEL=log

# OpenTelemetry env hooks. SDK wiring still pending — leave OTEL_ENABLED
# false until the @opentelemetry/sdk-node init lands.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Auth-security (round 14) -----------------------------------------------
# Public URL used to build verify-email + reset-password links from the
# EmailProvider. Must match the HTTPS origin the mobile/web client opens.
APP_PUBLIC_URL=https://app.yourdomain.com

# SMTP transport — leave blank to use the ConsoleEmailProvider (logs instead
# of sending). For real email, set SMTP_HOST + the four below. NOTE: the
# SMTP provider in the codebase is a skeleton until @nodemailer is wired
# (see docs/AUTH_SECURITY.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# ---- Encrypted off-box backups (round 14) -----------------------------------
# scripts/backup-db-encrypted.sh reads these. Generate the key once via
# `openssl rand -hex 32` and store it in your secret manager.
BACKUP_ENCRYPTION_KEY=
BACKUP_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# ---- Image tag (used by compose to pick which build to run) -----------------
LIFEOS_API_TAG=latest
