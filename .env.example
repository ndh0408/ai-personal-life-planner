# =============================================================================
# AI Personal Life Planner — root environment example
# =============================================================================
# Copy to .env at the same level you need it. NEVER commit real secrets.
# Each app also has its own .env.example (apps/api, apps/mobile).
# =============================================================================

# ---- Project ----
NODE_ENV=development
PROJECT_NAME=ai-personal-life-planner

# ---- Database (used by docker-compose and apps/api) ----
POSTGRES_USER=planner
POSTGRES_PASSWORD=planner_dev_password
POSTGRES_DB=planner
POSTGRES_PORT=5440
POSTGRES_HOST=localhost

# Convenience full URL (apps/api also defines its own)
# Port 5440 is used so local PostgreSQL on 5432 (if any) is not disturbed.
DATABASE_URL=postgresql://planner:planner_dev_password@localhost:5440/planner?schema=public
