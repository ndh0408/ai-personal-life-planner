# =============================================================================
# LifeOS AI — root environment example
# Copy to .env and fill in real values. Never commit .env.
# Values here are used by docker compose; the API loads its own .env from
# apps/api/.env when running outside containers.
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lifeos
POSTGRES_PORT=5432   # only meaningful with -f compose.dev.yaml

# ── Cache / queue ────────────────────────────────────────────────────────────
REDIS_PORT=6379      # only meaningful with -f compose.dev.yaml

# ── API container (compose.prod.yaml only) ───────────────────────────────────
# Generate fresh secrets per environment. Never reuse dev secrets in prod.
#
#   openssl rand -base64 48          # JWT secrets (>= 32 chars)
#   openssl rand -hex 32             # USER_AI_KEY_ENCRYPTION_KEY (exactly 64 hex chars)
#
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
USER_AI_KEY_ENCRYPTION_KEY=

# Comma-separated origins for the API's CORS allowlist. No wildcards in prod.
CORS_ORIGINS=https://app.lifeos.example.com

# OpenAI default model used when a user hasn't specified one.
OPENAI_DEFAULT_MODEL=gpt-4o-mini
