# =================================================================
# LifeOS AI — Root environment example
# Copy to .env and fill in real values. Never commit .env.
# =================================================================

# Postgres (used by docker-compose.yml and apps/api)
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lifeos
POSTGRES_PORT=5432

# Redis (used by docker-compose.yml and apps/api queue)
REDIS_PORT=6379

# Local exposed ports
API_PORT=4000
MOBILE_PORT=8081
