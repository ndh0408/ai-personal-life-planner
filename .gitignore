# Dependencies
node_modules/
.pnp
.pnp.js

# Builds
dist/
build/
*.tsbuildinfo

# Stray build artifacts in package source trees (round-40 ts-jest leak guard).
# Source files live as .ts / .tsx only — emitted JS belongs in dist/.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Env
.env
.env.*
!.env.example
!.env.production.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo

# Expo
.expo/
.expo-shared/
web-build/
*.jks
*.p12
*.key
*.mobileprovision
*.orig.*

# Native
ios/
android/
!apps/mobile/ios/
!apps/mobile/android/
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/

# Prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# Docker / data
data/
.docker-data/

# Test
coverage/

# Misc
.cache/
.turbo/
.eslintcache

# Claude Code (local-only state)
.claude/

# Android build artifacts (kept out — APKs are large + reproducible)
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/local.properties

# Local build outputs (APKs / IPAs / aabs). These are large and reproducible
# from source — push them to GitHub Releases or rsync to huy-server, never git.
builds/
*.apk
*.aab
*.ipa
