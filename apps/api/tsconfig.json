{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@lifeos/shared": ["../../packages/shared/src/index.ts"],
      "@lifeos/shared/*": ["../../packages/shared/src/*"],
      "@lifeos/prompts": ["../../packages/prompts/src/index.ts"],
      "@lifeos/prompts/*": ["../../packages/prompts/src/*"],
      "@lifeos/taxonomy": ["../../packages/taxonomy/src/index.ts"],
      "@lifeos/taxonomy/*": ["../../packages/taxonomy/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "prisma/**/*"]
}
