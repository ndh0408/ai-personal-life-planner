# =============================================================================
# apps/api — backend environment example
# Copy to apps/api/.env. NEVER commit secrets.
# =============================================================================

NODE_ENV=development
PORT=3000

# ---- Database ----
DATABASE_URL=postgresql://planner:planner_dev_password@localhost:5432/planner?schema=public

# ---- JWT ----
# IMPORTANT: replace these with strong random strings (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars_long
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS ----
# Comma-separated list of allowed origins. Use * only in dev.
CORS_ORIGIN=*

# ---- Rate limiting ----
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ---- AI provider (server-side only — NEVER expose to mobile) ----
# The mobile app calls our /ai endpoints; only the API talks to the AI provider.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
