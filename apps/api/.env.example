# =================================================================
# LifeOS AI — API environment example
# Copy to .env and fill in real values. Never commit .env.
# =================================================================

NODE_ENV=development
PORT=4000

# Postgres
DATABASE_URL=postgresql://lifeos:changeme@localhost:5432/lifeos?schema=public

# Redis (for cache + BullMQ queue)
REDIS_URL=redis://localhost:6379

# JWT
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Encryption for user OpenAI API keys (AES-256-GCM, 32-byte hex / 64 hex chars).
# Generate with: openssl rand -hex 32
USER_AI_KEY_ENCRYPTION_KEY=replace-with-64-char-hex-string

# OpenAI defaults — provider URL + per-feature model defaults (round 29).
# FAST: capture parser, memory extraction, action suggestions.
# SMART: assistant chat, planner, recommendations, insight generator.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_SMART_MODEL=gpt-5.5
OPENAI_DEFAULT_MODEL=gpt-5.4-mini

# CORS — comma separated exact origins (no wildcards in production).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Swagger — only enabled when explicitly true AND NODE_ENV != production
SWAGGER_ENABLED=true
