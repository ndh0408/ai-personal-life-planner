# =================================================================
# LifeOS AI — API environment example
# Copy to .env and fill in real values. Never commit .env.
# =================================================================

NODE_ENV=development
PORT=4000

# Postgres
DATABASE_URL=postgresql://lifeos:changeme@localhost:5432/lifeos?schema=public

# Redis (for BullMQ queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Encryption for storing user OpenAI API keys at rest (AES-256-GCM, 32-byte hex)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string

# CORS — comma separated. Use exact origins, not wildcards in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional: rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100
