// =============================================================================
// AI Personal Life Planner — Prisma schema (PostgreSQL)
//
// Conventions:
//   - All time-of-day-only fields use @db.Time(0) (e.g. UserProfile.usualWakeTime).
//   - All date-only fields use @db.Date (e.g. DailySchedule.date).
//   - Cascade deletes flow from User down to every owned record.
//   - Enums use SCREAMING_SNAKE_CASE per the product spec.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MainGoal {
  LOSE_WEIGHT
  GAIN_WEIGHT
  SLEEP_EARLY
  PRODUCTIVE
  STUDY
  HEALTHY
  BALANCE
}

enum ActivityLevel {
  LOW
  MEDIUM
  HIGH
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum Mood {
  HAPPY
  NORMAL
  STRESSED
  TIRED
  SAD
  MOTIVATED
}

enum DailyScheduleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ScheduleItemType {
  SLEEP
  MEAL
  WORK
  STUDY
  EXERCISE
  REST
  TASK
  TRAVEL
  CUSTOM
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ScheduleItemStatus {
  PENDING
  COMPLETED
  SKIPPED
  DELAYED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum SleepQuality {
  VERY_BAD
  BAD
  NORMAL
  GOOD
  VERY_GOOD
}

enum StressLevel {
  LOW
  MEDIUM
  HIGH
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIRecommendationStatus {
  NEW
  VIEWED
  APPLIED
  DISMISSED
}

enum NotificationPlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile             UserProfile?
  refreshTokens       RefreshToken[]
  schedules           DailySchedule[]
  scheduleItems       ScheduleItem[]
  tasks               Task[]
  habits              Habit[]
  habitLogs           HabitLog[]
  mealPlans           MealPlan[]
  mealSuggestions     MealSuggestion[]
  sleepLogs           SleepLog[]
  moodLogs            MoodLog[]
  aiConversations     AIConversation[]
  aiMessages          AIMessage[]
  aiRecommendations   AIRecommendation[]
  notificationDevices NotificationDevice[]
  notificationSetting NotificationSetting?
  notificationLogs    NotificationLog[]

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  fullName          String
  age               Int?
  gender            String?
  heightCm          Float?
  weightKg          Float?
  occupation        String?
  workStartTime     DateTime?      @db.Time(0)
  workEndTime       DateTime?      @db.Time(0)
  usualWakeTime     DateTime?      @db.Time(0)
  usualSleepTime    DateTime?      @db.Time(0)
  mainGoal          MainGoal?
  activityLevel     ActivityLevel?
  dietaryPreference String?
  healthNotes       String?
  timezone          String         @default("Asia/Ho_Chi_Minh")
  locale            String         @default("vi")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// -----------------------------------------------------------------------------
// Schedule
// -----------------------------------------------------------------------------

model DailySchedule {
  id          String              @id @default(uuid())
  userId      String
  date        DateTime            @db.Date
  wakeUpTime  DateTime?           @db.Time(0)
  sleepTime   DateTime?           @db.Time(0)
  summary     String?
  energyLevel EnergyLevel?
  mood        Mood?
  aiGenerated Boolean             @default(false)
  status      DailyScheduleStatus @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ScheduleItem[]

  @@unique([userId, date])
  @@index([userId, status])
  @@index([date])
  @@map("daily_schedules")
}

model ScheduleItem {
  id          String             @id @default(uuid())
  scheduleId  String
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  type        ScheduleItemType
  priority    Priority           @default(MEDIUM)
  status      ScheduleItemStatus @default(PENDING)
  aiGenerated Boolean            @default(false)
  reason      String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  schedule DailySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduleId, sortOrder])
  @@index([userId, status])
  @@index([userId, startTime])
  @@map("schedule_items")
}

// -----------------------------------------------------------------------------
// Tasks & Habits
// -----------------------------------------------------------------------------

model Task {
  id               String     @id @default(uuid())
  userId           String
  title            String
  description      String?
  dueDate          DateTime?
  priority         Priority   @default(MEDIUM)
  estimatedMinutes Int?
  status           TaskStatus @default(TODO)
  category         String?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@map("tasks")
}

model Habit {
  id          String         @id @default(uuid())
  userId      String
  name        String
  description String?
  frequency   HabitFrequency @default(DAILY)
  targetCount Int            @default(1)
  color       String?
  icon        String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, isActive])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  userId    String
  date      DateTime @db.Date
  completed Boolean  @default(false)
  count     Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_logs")
}

// -----------------------------------------------------------------------------
// Meals
// -----------------------------------------------------------------------------

model MealPlan {
  id                   String   @id @default(uuid())
  userId               String
  date                 DateTime @db.Date
  goal                 String?
  budget               String?
  availableIngredients String[]
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions MealSuggestion[]

  @@unique([userId, date])
  @@index([date])
  @@map("meal_plans")
}

model MealSuggestion {
  id                String   @id @default(uuid())
  mealPlanId        String
  userId            String
  mealType          MealType
  title             String
  description       String?
  ingredients       String[]
  estimatedCalories Int?
  prepTimeMinutes   Int?
  reason            String?
  healthNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mealPlanId, mealType])
  @@index([userId])
  @@map("meal_suggestions")
}

// -----------------------------------------------------------------------------
// Wellbeing logs
// -----------------------------------------------------------------------------

model SleepLog {
  id              String       @id @default(uuid())
  userId          String
  date            DateTime     @db.Date
  sleepTime       DateTime
  wakeTime        DateTime
  durationMinutes Int
  quality         SleepQuality
  note            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, quality])
  @@map("sleep_logs")
}

model MoodLog {
  id          String      @id @default(uuid())
  userId      String
  date        DateTime    @db.Date
  mood        Mood
  energyLevel EnergyLevel
  stressLevel StressLevel
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, mood])
  @@map("mood_logs")
}

// -----------------------------------------------------------------------------
// AI
// -----------------------------------------------------------------------------

model AIConversation {
  id          String   @id @default(uuid())
  userId      String
  title       String?
  contextType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(uuid())
  conversationId String
  userId         String
  role           AIMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("ai_messages")
}

model AIRecommendation {
  id         String                 @id @default(uuid())
  userId     String
  type       String
  title      String
  content    String
  priority   Priority               @default(MEDIUM)
  status     AIRecommendationStatus @default(NEW)
  sourceData Json?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, type])
  @@map("ai_recommendations")
}

// -----------------------------------------------------------------------------
// Notifications
// -----------------------------------------------------------------------------

model NotificationDevice {
  id         String               @id @default(uuid())
  userId     String
  platform   NotificationPlatform
  pushToken  String
  deviceName String?
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pushToken])
  @@index([userId, isActive])
  @@map("notification_devices")
}

model NotificationSetting {
  id                  String    @id @default(uuid())
  userId              String    @unique
  wakeReminder        Boolean   @default(true)
  sleepReminder       Boolean   @default(true)
  mealReminder        Boolean   @default(true)
  taskReminder        Boolean   @default(true)
  habitReminder       Boolean   @default(true)
  moodCheckinReminder Boolean   @default(true)
  quietHoursStart     DateTime? @db.Time(0)
  quietHoursEnd       DateTime? @db.Time(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model NotificationLog {
  id          String             @id @default(uuid())
  userId      String
  title       String
  body        String
  type        String
  scheduledAt DateTime?
  sentAt      DateTime?
  status      NotificationStatus @default(PENDING)
  error       String?
  createdAt   DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, type])
  @@index([scheduledAt])
  @@map("notification_logs")
}
