// =============================================================================
// LifeOS AI — Prisma schema (PostgreSQL)
//
// Conventions:
//   - Time-of-day-only fields use @db.Time(0).
//   - Date-only fields use @db.Date.
//   - Money fields use @db.Decimal(18, 2) — cents-safe up to 9.99 × 10^15.
//   - Cascade deletes flow from User down to every owned record.
//   - Enums use SCREAMING_SNAKE_CASE per the product spec.
//   - @@map uses snake_case table names.
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // `native` keeps local dev fast on macOS/Linux; the musl target matches
  // the alpine production image so the Docker build ships a compatible engine.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MainGoal {
  LOSE_WEIGHT
  GAIN_WEIGHT
  SLEEP_EARLY
  PRODUCTIVE
  STUDY
  HEALTHY
  BALANCE
  FINANCIAL_STABILITY
  CAREER_GROWTH
}

enum ActivityLevel {
  LOW
  MEDIUM
  HIGH
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum Mood {
  HAPPY
  NORMAL
  STRESSED
  TIRED
  SAD
  MOTIVATED
}

enum DailyScheduleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ScheduleItemType {
  SLEEP
  MEAL
  WORK
  STUDY
  EXERCISE
  REST
  TASK
  TRAVEL
  FINANCE
  HEALTH
  PERSONAL
  CUSTOM
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ScheduleItemStatus {
  PENDING
  COMPLETED
  SKIPPED
  DELAYED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum SleepQuality {
  VERY_BAD
  BAD
  NORMAL
  GOOD
  VERY_GOOD
}

enum StressLevel {
  LOW
  MEDIUM
  HIGH
}

enum WalletType {
  CASH
  BANK
  EWALLET
  SAVINGS
  OTHER
}

enum NeedLevel {
  NEED
  WANT
  WASTE
  INVESTMENT
  SAVING
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
}

enum DebtType {
  I_OWE
  OWED_TO_ME
}

enum DebtStatus {
  ACTIVE
  PAID
  CANCELLED
}

enum SavingGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GoalCategory {
  HEALTH
  FINANCE
  CAREER
  STUDY
  RELATIONSHIP
  PERSONAL
  OTHER
}

enum PersonalGoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum MilestoneStatus {
  TODO
  COMPLETED
  CANCELLED
}

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AIRecommendationType {
  SCHEDULE
  TASK
  HABIT
  MEAL
  SLEEP
  HEALTH
  FINANCE
  BUDGET
  GOAL
  GENERAL
}

enum AIRecommendationStatus {
  NEW
  VIEWED
  APPLIED
  DISMISSED
}

enum NotificationPlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// =============================================================================
// A. Auth / User
// =============================================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  profile                  UserProfile?
  refreshTokens            RefreshToken[]
  schedules                DailySchedule[]
  scheduleItems            ScheduleItem[]
  tasks                    Task[]
  habits                   Habit[]
  habitLogs                HabitLog[]
  mealPlans                MealPlan[]
  mealSuggestions          MealSuggestion[]
  mealLogs                 MealLog[]
  sleepLogs                SleepLog[]
  moodLogs                 MoodLog[]
  healthMetrics            HealthMetric[]
  wallets                  Wallet[]
  incomes                  Income[]
  expenses                 Expense[]
  budgets                  Budget[]
  debts                    Debt[]
  savingGoals              SavingGoal[]
  financialSnapshots       FinancialSnapshot[]
  personalGoals            PersonalGoal[]
  goalMilestones           GoalMilestone[]
  aiConversations          AIConversation[]
  aiMessages               AIMessage[]
  aiRecommendations        AIRecommendation[]
  dailyReviews             DailyReview[]
  weeklyReviews            WeeklyReview[]
  notificationDevices      NotificationDevice[]
  notificationSetting      NotificationSetting?
  notificationLogs         NotificationLog[]
  aiProviders              UserAiProvider[]
  aiPreference             UserAiPreference?
  privacySetting           PrivacySetting?
  consents                 UserConsent[]
  sensitiveAccessLogs      SensitiveAccessLog[]
  recommendationEvidences  RecommendationEvidence[]
  personalizationMemories  AiPersonalizationMemory[]
  communicationSetting     CommunicationSetting?
  memoryConsent            MemoryConsent?
  connectedAccounts        ConnectedAccount[]
  emailItems               EmailItem[]
  emailReminders           EmailReminder[]
  messageReminders         MessageReminder[]
  companionMemories        AICompanionMemory[]
  smartCheckinSetting      SmartCheckinSetting?
  voiceCaptures            VoiceCapture[]
  suggestedActions         SuggestedAction[]
  healthIntegrationSetting HealthIntegrationSetting?
  contextSignals           ContextSignal[]
  contextInferences        ContextInference[]
  userPatterns             UserPattern[]
  widgetPreferences        WidgetPreferences?
  aiUsageLogs              AiUsageLog[]
  aiUsageQuota             AiUsageQuota?

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  fullName          String
  age               Int?
  gender            String?
  heightCm          Float?
  weightKg          Float?
  occupation        String?
  workStartTime     DateTime?      @db.Time(0)
  workEndTime       DateTime?      @db.Time(0)
  usualWakeTime     DateTime?      @db.Time(0)
  usualSleepTime    DateTime?      @db.Time(0)
  mainGoal          MainGoal?
  activityLevel     ActivityLevel?
  dietaryPreference String?
  healthNotes       String?
  monthlySalary     Decimal?       @db.Decimal(18, 2)
  salaryDay         Int?
  currency          String         @default("VND")
  timezone          String         @default("Asia/Ho_Chi_Minh")
  locale            String         @default("vi")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// =============================================================================
// B. Planner / Schedule
// =============================================================================

model DailySchedule {
  id          String              @id @default(uuid())
  userId      String
  date        DateTime            @db.Date
  wakeUpTime  DateTime?           @db.Time(0)
  sleepTime   DateTime?           @db.Time(0)
  summary     String?
  energyLevel EnergyLevel?
  mood        Mood?
  aiGenerated Boolean             @default(false)
  status      DailyScheduleStatus @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ScheduleItem[]

  @@unique([userId, date])
  @@index([userId, status])
  @@index([date])
  @@map("daily_schedules")
}

model ScheduleItem {
  id          String             @id @default(uuid())
  scheduleId  String
  userId      String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  type        ScheduleItemType
  priority    Priority           @default(MEDIUM)
  status      ScheduleItemStatus @default(PENDING)
  aiGenerated Boolean            @default(false)
  reason      String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  schedule DailySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduleId, sortOrder])
  @@index([userId, status])
  @@index([userId, startTime])
  @@map("schedule_items")
}

// =============================================================================
// C. Tasks
// =============================================================================

model Task {
  id               String     @id @default(uuid())
  userId           String
  title            String
  description      String?
  dueDate          DateTime?
  priority         Priority   @default(MEDIUM)
  estimatedMinutes Int?
  status           TaskStatus @default(TODO)
  category         String?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, priority])
  @@index([userId, category])
  @@map("tasks")
}

// =============================================================================
// D. Habits
// =============================================================================

model Habit {
  id          String         @id @default(uuid())
  userId      String
  name        String
  description String?
  frequency   HabitFrequency @default(DAILY)
  targetCount Int            @default(1)
  color       String?
  icon        String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, isActive])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  userId    String
  date      DateTime @db.Date
  completed Boolean  @default(false)
  count     Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_logs")
}

// =============================================================================
// E. Meals / Nutrition
// =============================================================================

model MealPlan {
  id                   String   @id @default(uuid())
  userId               String
  date                 DateTime @db.Date
  goal                 String?
  budget               String?
  availableIngredients String[]
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestions MealSuggestion[]

  @@unique([userId, date])
  @@index([date])
  @@map("meal_plans")
}

model MealSuggestion {
  id                String   @id @default(uuid())
  mealPlanId        String
  userId            String
  mealType          MealType
  title             String
  description       String?
  ingredients       String[]
  estimatedCalories Int?
  prepTimeMinutes   Int?
  reason            String?
  healthNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mealPlanId, mealType])
  @@index([userId])
  @@map("meal_suggestions")
}

model MealLog {
  id                String   @id @default(uuid())
  userId            String
  date              DateTime @db.Date
  mealType          MealType
  title             String
  note              String?
  estimatedCalories Int?
  cost              Decimal? @db.Decimal(18, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, mealType])
  @@map("meal_logs")
}

// =============================================================================
// F. Sleep / Mood / Health
// =============================================================================

model SleepLog {
  id              String       @id @default(uuid())
  userId          String
  date            DateTime     @db.Date
  sleepTime       DateTime
  wakeTime        DateTime
  durationMinutes Int
  quality         SleepQuality
  note            String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, quality])
  @@map("sleep_logs")
}

model MoodLog {
  id          String      @id @default(uuid())
  userId      String
  date        DateTime    @db.Date
  mood        Mood
  energyLevel EnergyLevel
  stressLevel StressLevel
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, mood])
  @@map("mood_logs")
}

model HealthMetric {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @db.Date
  weightKg        Float?
  waterIntakeMl   Int?
  steps           Int?
  exerciseMinutes Int?
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("health_metrics")
}

// =============================================================================
// G. Finance
// =============================================================================

model Wallet {
  id        String     @id @default(uuid())
  userId    String
  name      String
  type      WalletType
  balance   Decimal    @default(0) @db.Decimal(18, 2)
  currency  String     @default("VND")
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes  Income[]
  expenses Expense[]

  @@index([userId, isActive])
  @@index([userId, type])
  @@map("wallets")
}

model Income {
  id            String   @id @default(uuid())
  userId        String
  walletId      String?
  title         String
  amount        Decimal  @db.Decimal(18, 2)
  category      String?
  source        String?
  incomeDate    DateTime @db.Date
  isRecurring   Boolean  @default(false)
  recurringRule String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId, incomeDate])
  @@index([userId, category])
  @@index([walletId])
  @@map("incomes")
}

model Expense {
  id            String     @id @default(uuid())
  userId        String
  walletId      String?
  title         String
  amount        Decimal    @db.Decimal(18, 2)
  category      String
  expenseDate   DateTime   @db.Date
  paymentMethod String?
  needLevel     NeedLevel?
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId, expenseDate])
  @@index([userId, category])
  @@index([userId, needLevel])
  @@index([walletId])
  @@map("expenses")
}

model Budget {
  id                    String       @id @default(uuid())
  userId                String
  category              String
  amount                Decimal      @db.Decimal(18, 2)
  period                BudgetPeriod @default(MONTHLY)
  startDate             DateTime     @db.Date
  endDate               DateTime     @db.Date
  alertThresholdPercent Int          @default(80)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, startDate, endDate])
  @@map("budgets")
}

model Debt {
  id          String     @id @default(uuid())
  userId      String
  type        DebtType
  personName  String?
  title       String
  totalAmount Decimal    @db.Decimal(18, 2)
  paidAmount  Decimal    @default(0) @db.Decimal(18, 2)
  dueDate     DateTime?  @db.Date
  status      DebtStatus @default(ACTIVE)
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, dueDate])
  @@map("debts")
}

model SavingGoal {
  id            String           @id @default(uuid())
  userId        String
  title         String
  targetAmount  Decimal          @db.Decimal(18, 2)
  currentAmount Decimal          @default(0) @db.Decimal(18, 2)
  targetDate    DateTime?        @db.Date
  priority      Priority         @default(MEDIUM)
  status        SavingGoalStatus @default(ACTIVE)
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, priority])
  @@map("saving_goals")
}

model FinancialSnapshot {
  id                 String   @id @default(uuid())
  userId             String
  month              String // "YYYY-MM" — simpler filter than a date range
  totalIncome        Decimal  @db.Decimal(18, 2)
  totalExpense       Decimal  @db.Decimal(18, 2)
  totalSaving        Decimal  @db.Decimal(18, 2)
  debtRemaining      Decimal  @db.Decimal(18, 2)
  budgetUsagePercent Decimal? @db.Decimal(6, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([month])
  @@map("financial_snapshots")
}

// =============================================================================
// H. Personal Goals
// =============================================================================

model PersonalGoal {
  id           String             @id @default(uuid())
  userId       String
  title        String
  description  String?
  category     GoalCategory
  targetValue  Float?
  currentValue Float?
  unit         String?
  deadline     DateTime?          @db.Date
  priority     Priority           @default(MEDIUM)
  status       PersonalGoalStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, priority])
  @@map("personal_goals")
}

model GoalMilestone {
  id          String          @id @default(uuid())
  goalId      String
  userId      String
  title       String
  targetDate  DateTime?       @db.Date
  completedAt DateTime?
  status      MilestoneStatus @default(TODO)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  goal PersonalGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, status])
  @@index([userId, status])
  @@map("goal_milestones")
}

// =============================================================================
// I. AI / Assistant
// =============================================================================

model AIConversation {
  id          String   @id @default(uuid())
  userId      String
  title       String?
  contextType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String        @id @default(uuid())
  conversationId String
  userId         String
  role           AIMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("ai_messages")
}

model AIRecommendation {
  id         String                 @id @default(uuid())
  userId     String
  type       AIRecommendationType
  title      String
  content    String
  priority   Priority               @default(MEDIUM)
  status     AIRecommendationStatus @default(NEW)
  sourceData Json?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidences RecommendationEvidence[]

  @@index([userId, status])
  @@index([userId, type])
  @@map("ai_recommendations")
}

model DailyReview {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  summary     String
  wins        Json?
  issues      Json?
  suggestions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("daily_reviews")
}

model WeeklyReview {
  id              String   @id @default(uuid())
  userId          String
  weekStart       DateTime @db.Date
  summary         String
  scheduleInsight String?
  taskInsight     String?
  habitInsight    String?
  healthInsight   String?
  mealInsight     String?
  financeInsight  String?
  goalInsight     String?
  suggestions     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([weekStart])
  @@map("weekly_reviews")
}

// =============================================================================
// J. Notifications
// =============================================================================

model NotificationDevice {
  id         String               @id @default(uuid())
  userId     String
  platform   NotificationPlatform
  pushToken  String
  deviceName String?
  isActive   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pushToken])
  @@index([userId, isActive])
  @@map("notification_devices")
}

model NotificationSetting {
  id                  String    @id @default(uuid())
  userId              String    @unique
  wakeReminder        Boolean   @default(true)
  sleepReminder       Boolean   @default(true)
  mealReminder        Boolean   @default(true)
  taskReminder        Boolean   @default(true)
  habitReminder       Boolean   @default(true)
  moodCheckinReminder Boolean   @default(true)
  financeReminder     Boolean   @default(true)
  budgetAlert         Boolean   @default(true)
  goalReminder        Boolean   @default(true)
  assistantNudge      Boolean   @default(true)
  quietHoursStart     DateTime? @db.Time(0)
  quietHoursEnd       DateTime? @db.Time(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model NotificationLog {
  id             String             @id @default(uuid())
  userId         String
  title          String
  body           String
  type           String
  // Per-user idempotency key. The dispatcher refuses to enqueue a second
  // notification with the same key inside DEDUPE_WINDOW_MIN.
  idempotencyKey String?
  attempts       Int                @default(0)
  scheduledAt    DateTime?
  sentAt         DateTime?
  status         NotificationStatus @default(PENDING)
  error          String?
  createdAt      DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([userId, type])
  @@index([scheduledAt])
  @@map("notification_logs")
}

// =============================================================================
// J. User AI Providers — Bring Your Own Key (BYOK)
// =============================================================================

enum UserAiProviderType {
  NVIDIA
  OPENAI
  GEMINI
  ANTHROPIC
  OPENROUTER
  CUSTOM_OPENAI_COMPATIBLE
}

enum UserAiProviderTestStatus {
  SUCCESS
  FAILED
}

model UserAiProvider {
