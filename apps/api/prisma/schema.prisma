model ConnectedAccount {
  id                    String                   @id @default(uuid())
  userId                String
  provider              ConnectedAccountProvider
  email                 String
  displayName           String?
  // OAuth tokens — AES-256-GCM via EncryptionService.
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  scopes                Json
  isActive              Boolean                  @default(true)
  lastSyncedAt          DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails EmailItem[]

  @@unique([userId, provider, email])
  @@index([userId])
  @@map("connected_accounts")
}

model EmailItem {
  id                 String         @id @default(uuid())
  userId             String
  connectedAccountId String
  externalId         String
  threadId           String?
  fromName           String?
  fromEmail          String?
  subject            String
  // Snippet only stored when emailSnippetSync is on.
  snippet            String?
  receivedAt         DateTime
  isRead             Boolean        @default(false)
  isImportant        Boolean        @default(false)
  needsReply         Boolean        @default(false)
  hasDeadline        Boolean        @default(false)
  detectedDeadlineAt DateTime?
  category           EmailCategory?
  // Short AI-produced summary of WHY the AI flagged it. Never the full body.
  aiSummary          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  reminders        EmailReminder[]

  @@unique([connectedAccountId, externalId])
  @@index([userId, receivedAt])
  @@index([userId, isImportant])
  @@index([userId, needsReply])
  @@index([userId, hasDeadline])
  @@index([userId, category])
  @@map("email_items")
}

model EmailReminder {
