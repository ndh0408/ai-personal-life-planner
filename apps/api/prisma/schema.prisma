// =============================================================================
// K. Privacy & Consent — Permission Center / data-usage gates
// =============================================================================

enum UserConsentType {
  TOS
  PRIVACY_POLICY
  AI_PROCESSING
  PERSONALIZATION
  DIAGNOSTICS
  NOTIFICATIONS
  CALENDAR
  LOCATION
  HEALTH_FITNESS
  MICROPHONE
  CAMERA
  PHOTOS
}

model PrivacySetting {
  id                     String  @id @default(uuid())
  userId                 String  @unique
  // Master switch — when false, the AI services revert to bare minimum
  // (locale + timezone) and stop personalising.
  personalizationEnabled Boolean @default(true)

  // Per-domain "may we send this to AI?" toggles. The resolver/services
  // check these BEFORE attaching that data to a prompt.
  useScheduleForAI Boolean @default(true)
  useTasksForAI    Boolean @default(true)
  useHabitsForAI   Boolean @default(true)
  useMealsForAI    Boolean @default(true)
  useHealthForAI   Boolean @default(true)
  useFinanceForAI  Boolean @default(true)
  useGoalsForAI    Boolean @default(true)
  // Legacy alias kept for the v1.1 mobile clients still in flight; the
  // resolver treats it as equivalent to `useMealsForAI`. New code reads
  // the singular form. Safe to drop once mobile pins to >=1.2.
  useMealForAI     Boolean @default(true)

  // Per-OS-permission "may we use this device capability?" toggles.
  // These gate BOTH the OS prompt and the AI ingestion of that data.
  useCalendarContext      Boolean @default(false)
  useLocationContext      Boolean @default(false)
  useHealthFitnessContext Boolean @default(false)
  // Renamed from voiceInputEnabled in v1.2 — kept the old column name in
  // the table for backwards compatibility (no migration churn for existing
  // rows). The DTO surfaces both `voiceInputEnabled` and `useVoiceInput`.
  voiceInputEnabled       Boolean @default(false)

  // Behaviour toggles
  proactiveRecommendations Boolean @default(true)
  // Anonymised app diagnostics — opt-IN by default-off (per privacy spec).
  anonymizedDiagnostics    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model UserConsent {
  id          String          @id @default(uuid())
  userId      String
  consentType UserConsentType
  // True for grant, false for revoke. Revocation writes a NEW row with
  // granted=false rather than mutating the previous one — this gives us a
  // permanent audit trail of opt-in/opt-out events.
  granted     Boolean
  // Free-form policy version string ("2026-04-25" or "v1.0.0") so we can
  // detect users on outdated terms.
  version     String
  // Server timestamp the row was created. `revokedAt` is filled when a later
  // revoke event references this grant; left null otherwise.
  grantedAt   DateTime        @default(now())
  revokedAt   DateTime?
  // Source / context: { source: 'onboarding' | 'settings' | 'pre-feature',
  // platform, locale, ipHash } — never raw IP.
  metadata    Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@index([userId, grantedAt])
  @@map("user_consents")
}

// =============================================================================
// L. Personalization context — sensitive-access audit + recommendation
//    evidence + AI memory ledger.
// =============================================================================

enum SensitiveDataType {
  SCHEDULE
  TASKS
  HABITS
  MEALS
  HEALTH
  FINANCE
  GOALS
  CALENDAR
  LOCATION
  HEALTH_FITNESS
}

enum AiMemoryType {
  PREFERENCE
  PATTERN
  GOAL
  ROUTINE
  WARNING
  OTHER
}

model SensitiveAccessLog {
  id            String            @id @default(uuid())
  userId        String
  dataType      SensitiveDataType
  // Short purpose tag — eg "ai-finance:analyze", "assistant:nudge".
  purpose       String
  // Component that performed the read — service class name. Never raw IP.
  accessedBy    String
  // Feature surface the access was triggered from — eg "POST /api/ai/analyze-finance".
  sourceFeature String
  createdAt     DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, dataType])
  @@map("sensitive_access_logs")
}

model RecommendationEvidence {
  id               String            @id @default(uuid())
  recommendationId String
  userId           String
  dataType         SensitiveDataType
  // Human-friendly one-liner the user can read inside "Why am I seeing this?".
  // Stored as locale-tagged plain text — see locale field. Never contains
  // raw monetary amounts, raw notes, or raw transaction descriptions.
  summary          String
  locale           String            @default("vi")
  // Optional weight 0..1 representing how much this evidence influenced the
  // recommendation. Resolver / mobile may sort by this for the UI.
  weight           Float?
  createdAt        DateTime          @default(now())

  recommendation AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@index([userId, createdAt])
  @@map("recommendation_evidences")
}

model AiPersonalizationMemory {
  id         String       @id @default(uuid())
  userId     String
  memoryType AiMemoryType
  // Free-form extracted memory line, eg "prefers light dinners on weekdays".
  // Bounded at the application layer so a malicious prompt can't write a
  // megabyte. Never contains PII the user did not enter themselves.
  content    String
  // Where this memory came from — eg "chat:2026-04-25", "daily-review",
  // "manual:profile". Used for traceability + Clear AI memory UI.
  source     String
  // 0..1 model-supplied confidence; nullable for human-entered memories.
  confidence Float?
  // Soft delete: clearing AI memory flips this off rather than hard delete,
  // so we keep an audit trail of "memory existed at point in time".
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, memoryType])
  @@map("ai_personalization_memories")
}

