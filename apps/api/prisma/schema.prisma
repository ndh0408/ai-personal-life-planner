// LifeOS AI — Prisma schema
//
// Conventions used throughout:
//   • cuid() ids
//   • Money is `Decimal @db.Decimal(18, 2)` — never Float, never Int
//     (precision 18, scale 2 covers VND up to ~10^16, with 2-digit forex headroom)
//   • Soft delete: `deletedAt DateTime?` on finance + tasks (and a partial-style
//     index on `[userId, deletedAt]` for "live rows for this user" queries)
//   • Every entity scoped to a user has `@@index([userId])`
//   • Date-range entities also get `@@index([userId, <dateColumn>])`
//   • Cascade delete from User down — privacy/right-to-erasure relies on this
//
// See docs/DATABASE_SCHEMA.md for the narrative version.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums --------------------------------------------------------------

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AiProvider {
  OPENAI
}

enum AiKeyTestStatus {
  SUCCESS
  FAILED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum SleepQuality {
  BAD
  OK
  GOOD
}

enum Mood {
  GREAT
  GOOD
  OK
  TIRED
  STRESSED
  SAD
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

// Round 35: provenance tag on every passively-logged datum.
// MANUAL  — user typed it / confirmed it via Smart Capture.
// DEVICE  — synced from HealthKit / Health Connect.
// INFERRED — derived from app-activity heuristics (e.g. sleep from
//           inactivity 23:00→07:00 with no foreground events).
enum DataSource {
  MANUAL
  DEVICE
  INFERRED
}

enum DailyPlanItemType {
  TASK
  MEAL
  REST
  WORK
  PERSONAL
  HEALTH
  FINANCE
  CUSTOM
}

enum DailyPlanItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiRecommendationType {
  SCHEDULE
  TASK
  MEAL
  SLEEP
  MOOD
  FINANCE
  GENERAL
}

enum AiRecommendationPriority {
  LOW
  MEDIUM
  HIGH
}

enum AiRecommendationStatus {
  NEW
  VIEWED
  DISMISSED
  APPLIED
}

enum QuickCaptureStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// ---------- Identity ------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  displayName     String?
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Brute-force defence (round 19): tracked per account so attackers can't
  // bypass IP-based throttling by rotating addresses. All four fields reset
  // on a successful login.
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockUntil         DateTime?
  lastLoginAt       DateTime?

  profile             UserProfile?
  aiKey               UserAiKey?
  privacy             PrivacySetting?
  notificationSetting NotificationSetting?

  refreshTokens   RefreshToken[]
  wallets         Wallet[]
  expenses        Expense[]
  incomes         Income[]
  tasks           Task[]
  meals           MealLog[]
  sleeps          SleepLog[]
  moods           MoodLog[]
  dailyPlans      DailyPlan[]
  dailyPlanItems  DailyPlanItem[]
  aiConversations AIConversation[]
  aiMessages      AIMessage[]
  aiRecs          AIRecommendation[]
  aiUsages        AiUsageLog[]
  quickCaptures   QuickCapture[]
  behaviorSummary UserBehaviorSummary?
  events          EventLog[]
  memories        AssistantMemory[]
  subscription    Subscription?

  @@index([status])
}

// ---------- Subscriptions / billing (Round 41) ---------------------------------
//
// Stored as a 1:1 row per user. Tier + status come from the active billing
// provider's webhook (App Store / Play / Stripe). LIFETIME is special: no
// expiry, oneTime purchase tracked separately.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  tier                 String    @default("FREE")
  status               String    @default("NONE")
  provider             String    @default("none")
  providerCustomerId   String?
  providerSubscriptionId String?
  currentPeriodEnd     DateTime?
  autoRenew            Boolean   @default(false)
  lifetimePurchasedAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([status])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model UserProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  preferredName         String?
  locale                String    @default("vi")
  timezone              String    @default("Asia/Ho_Chi_Minh")
  currency              String    @default("VND")
  // Free-form goal tags chosen during onboarding; small list, JSON keeps it portable.
  mainGoals             Json      @default("[]")
  usualWakeTime         String?   // "07:00" — local wall-clock, not a DateTime
  usualSleepTime        String?   // "23:30"
  // Round 18 — "understand the user" expansion.
  // Foods/activities the user explicitly does NOT want suggested.
  dislikes              Json      @default("[]")  // string[]
  allergies             Json      @default("[]")  // string[]
  // One-line goal for the current month (free text), shown to AI verbatim.
  monthlyGoal           String?
  // 'morning' | 'evening' | 'night-owl' | 'flexible' — drives plan rhythm.
  workPattern           String?
  // VND/month soft cap; AI nudges when running spend > 0.7 of this.
  budgetMonthly         Decimal?  @db.Decimal(18, 2)
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Round 18: behaviour + memory ---------------------------------------

/// Computed snapshot of user behaviour patterns. One row per user, recomputed
/// on a lazy hourly job (or on-demand from the planner). Avoids re-aggregating
/// 90 days of history every time the AI runs.
model UserBehaviorSummary {
  id                    String   @id @default(cuid())
  userId                String   @unique
  // Hour-of-day histograms (24-bucket arrays) — typical wake/sleep moments.
  wakeHistogram         Json     @default("[]")
  sleepHistogram        Json     @default("[]")
  // Average sleep minutes per weekday (Sun..Sat). Length 7.
  avgSleepByWeekday     Json     @default("[]")
  // Peak focus window in local hour (e.g. {"start": 9, "end": 12}).
  peakFocus             Json?
  // Top 5 expense categories with weekly amount.
  topExpenseCategories  Json     @default("[]")
  // Top 5 meal titles (for variety rotation).
  recentMealTitles      Json     @default("[]")
  // Pearson r between sleep hours and next-day mood score (-1..1) or null when n<5.
  moodSleepCorrelation  Float?
  // Task completion rate by priority — { LOW: 0.7, MEDIUM: 0.55, HIGH: 0.83 }
  taskCompletionByPrio  Json     @default("{}")
  // Last computed at + N events processed.
  computedAt            DateTime @default(now())
  eventsAtCompute       Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only stream of user actions. The AI reads the most recent N events
/// to understand "what just happened" without re-querying every entity table.
model EventLog {
  id        String   @id @default(cuid())
  userId    String
  // 'CAPTURE_PARSED' | 'CAPTURE_CONFIRMED' | 'CAPTURE_EDITED' |
  // 'PLAN_ITEM_DONE' | 'PLAN_ITEM_SKIP' | 'PLAN_ITEM_EDITED' |
  // 'INSIGHT_LIKED' | 'INSIGHT_DISMISSED' | 'TASK_COMPLETED' | 'TASK_DELETED'
  kind      String
  // The original user text or item title — short summary suitable for AI.
  summary   String
  // Free-form payload (kind-specific). Keep small.
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Long-term memory for the Assistant. The chat job extracts atomic facts
/// from each turn ("user prefers cơm gà over phở", "user works night shifts")
/// and injects the highest-weight ones into the system prompt of subsequent
/// chats. Like ChatGPT memory but per-user, on the user's own key.
model AssistantMemory {
  id          String   @id @default(cuid())
  userId      String
  fact        String
  // 0..1 — manual feedback bumps this; old unconfirmed facts decay.
  weight      Float    @default(0.5)
  // 'preference' | 'constraint' | 'goal' | 'fact'
  kind        String
  // Source conversationId so the user can audit / delete.
  sourceConvId String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weight])
}

/// Round 36: per-user, per-source watermark for sensor sync. The phone
/// pushes data via /device-data/sync; the API persists the latest sample
/// timestamp it has accepted so the next call only sends new rows. One
/// row per (userId, source).
model DeviceSyncCursor {
  id            String   @id @default(cuid())
  userId        String
  /// 'health-connect' | 'healthkit' | 'inferred'
  source        String
  /// Last sample timestamp we have ingested for this source.
  lastSyncedAt  DateTime
  /// Free-form provider metadata (device model, OS version) for debugging.
  meta          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, source])
  @@index([userId])
}

/// Round 36: optional heart-rate trend store. We don't keep every beat —
/// the sync job aggregates to 5-min buckets (avg + max) so a week of HR
/// stays small. Only populated when health permission is granted.
model HeartRateSample {
  id             String   @id @default(cuid())
  userId         String
  bucketStart    DateTime
  /// Beats per minute, mean over the bucket.
  avgBpm         Int
  maxBpm         Int
  /// Same DataSource semantics as SleepLog.
  source         DataSource @default(DEVICE)
  deviceRecordId String?
  createdAt      DateTime @default(now())

  @@unique([userId, bucketStart])
  @@index([userId, bucketStart])
}

/// Round 36: passive activity samples — steps + foreground-app usage
/// minutes per 30-min bucket. Powers circadian + stress detection
/// without forcing the user to log anything.
model ActivitySample {
  id           String     @id @default(cuid())
  userId       String
  bucketStart  DateTime
  steps        Int        @default(0)
  /// Foreground app minutes the user spent inside LifeOS during the bucket.
  appMinutes   Int        @default(0)
  source       DataSource @default(INFERRED)
  createdAt    DateTime   @default(now())

  @@unique([userId, bucketStart])
  @@index([userId, bucketStart])
}

// ---------- AI credentials ------------------------------------------------------

model UserAiKey {
  id              String           @id @default(cuid())
  userId          String           @unique
  provider        AiProvider       @default(OPENAI)
  // Packed AES-256-GCM payload "v1:gcm:<iv_b64>:<tag_b64>:<ct_b64>" — see EncryptionService.
  encryptedApiKey String
  apiKeyLast4     String           // e.g. "x9aB" — used only for display
  maskedApiKey    String           // e.g. "sk-•••••••••x9aB" — pre-rendered, safe to send to mobile
  baseUrl         String           @default("https://api.openai.com/v1")
  defaultModel    String?
  lastTestedAt    DateTime?
  lastTestStatus  AiKeyTestStatus?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Finance -------------------------------------------------------------

model Wallet {
  id        String    @id @default(cuid())
  userId    String
  name      String
  balance   Decimal   @default(0) @db.Decimal(18, 2)
  currency  String    @default("VND")
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]
  incomes  Income[]

  @@index([userId])
  @@index([userId, deletedAt])
}

model Expense {
  id              String    @id @default(cuid())
  userId          String
  walletId        String
  title           String
  amount          Decimal   @db.Decimal(18, 2)
  category        String
  expenseDate     DateTime
  note            String?
  idempotencyKey  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  // Idempotency: same key twice from the same user must collapse to one row.
  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([userId, expenseDate])
  @@index([userId, deletedAt])
  @@index([walletId])
}

model Income {
  id              String    @id @default(cuid())
  userId          String
  walletId        String
  title           String
  amount          Decimal   @db.Decimal(18, 2)
  category        String?
  incomeDate      DateTime
  note            String?
  idempotencyKey  String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([userId, incomeDate])
  @@index([userId, deletedAt])
  @@index([walletId])
}

// ---------- Tasks ---------------------------------------------------------------

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  dueAt       DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([userId, deletedAt])
}

// ---------- Health journal ------------------------------------------------------

model MealLog {
  id        String     @id @default(cuid())
  userId    String
  mealType  MealType
  title     String
  cost      Decimal?   @db.Decimal(18, 2)
  loggedAt  DateTime
  note      String?
  source    DataSource @default(MANUAL)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, loggedAt])
}

model SleepLog {
  id              String        @id @default(cuid())
  userId          String
  sleepAt         DateTime
  wakeAt          DateTime
  durationMinutes Int
  quality         SleepQuality?
  note            String?
  // Round 35: where the row came from (manual capture vs. Health Connect
  // sync vs. inferred from app-inactivity). Lets the UI badge data
  // source and the assistant qualify confidence ("Tracked by your phone").
  source          DataSource    @default(MANUAL)
  /// Optional foreign id from the device platform (HealthKit sample UUID
  /// or Health Connect record id) — used by the sync job to dedupe.
  deviceRecordId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, sleepAt])
  @@index([userId, source, sleepAt])
}

model MoodLog {
  id        String      @id @default(cuid())
  userId    String
  mood      Mood
  energy    EnergyLevel
  loggedAt  DateTime
  note      String?
  source    DataSource  @default(MANUAL)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, loggedAt])
}

// ---------- Planner -------------------------------------------------------------

model DailyPlan {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  summary     String?
  aiGenerated Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items DailyPlanItem[]

  @@unique([userId, date])
  @@index([userId])
  @@index([userId, date])
}

model DailyPlanItem {
  id          String              @id @default(cuid())
  userId      String
  dailyPlanId String
  title       String
  startAt     DateTime?
  endAt       DateTime?
  type        DailyPlanItemType
  status      DailyPlanItemStatus @default(PENDING)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dailyPlanId])
  @@index([userId, status])
}

// ---------- AI conversation -----------------------------------------------------

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String        @id @default(cuid())
  userId         String
  conversationId String
  role           AiMessageRole
  content        String
  createdAt      DateTime      @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId, createdAt])
}

model AIRecommendation {
  id          String                   @id @default(cuid())
  userId      String
  type        AiRecommendationType
  title       String
  content     String
  priority    AiRecommendationPriority @default(MEDIUM)
  status      AiRecommendationStatus   @default(NEW)
  // Free-form: the rows / aggregates the LLM looked at when generating this.
  evidence    Json?
  /// Round 37: short one-line "Why this?" rationale shown in the UI sheet.
  /// Up to 240 chars, plain text. Distinct from `content` which is the
  /// nudge body — `explainText` is the meta-explanation of *why* the
  /// nudge surfaced ("Bạn ngủ < 6h ba đêm liên tiếp").
  explainText String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, type])
}

model AiUsageLog {
  id         String   @id @default(cuid())
  userId     String
  feature    String   // "capture.parse", "assistant.recommend", …
  model      String?
  success    Boolean
  errorCode  String?
  latencyMs  Int?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

// ---------- Privacy + notifications --------------------------------------------

model PrivacySetting {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  personalizationEnabled   Boolean  @default(true)
  useFinanceForAI          Boolean  @default(true)
  useHealthForAI           Boolean  @default(true)
  useMealsForAI            Boolean  @default(true)
  useTasksForAI            Boolean  @default(true)
  aiMemoryEnabled          Boolean  @default(true)
  proactiveRecommendations Boolean  @default(true)

  // Round 40: macro privacy tier (CLOUD / HYBRID / LOCAL). When LOCAL, the
  // server effectively becomes read-only for this user — no LLM calls, no
  // memory writes. The string enum is intentional so client + API stay in
  // sync via @lifeos/taxonomy without a separate Postgres enum migration.
  tier                     String   @default("CLOUD")
  e2eeKeyFingerprint       String?
  onDeviceLlmReady         Boolean  @default(false)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationSetting {
  id               String   @id @default(cuid())
  userId           String   @unique
  taskReminder     Boolean  @default(true)
  mealReminder     Boolean  @default(true)
  sleepReminder    Boolean  @default(true)
  financeReminder  Boolean  @default(true)
  assistantNudge   Boolean  @default(true)
  quietHoursStart  String?  // "22:00"
  quietHoursEnd    String?  // "07:00"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Quick Capture -------------------------------------------------------

enum CaptureParseSource {
  RULE
  LLM
  HYBRID
  MANUAL
}

model QuickCapture {
  id            String             @id @default(cuid())
  userId        String
  rawText       String
  // The structured outputs returned by the parser; kept verbatim until confirmed.
  parsedActions Json
  status        QuickCaptureStatus @default(DRAFT)

  // Round 21: parse provenance + audit trail.
  parseSource       CaptureParseSource?
  parseConfidence   Decimal?            @db.Decimal(5, 4)
  parseNeedsReview  Boolean             @default(false)
  parsedKind        String?             // EXPENSE|INCOME|TASK|MEAL|SLEEP|MOOD|UNKNOWN
  parsedPayload     Json?
  finalKind         String?
  finalPayload      Json?
  appliedEntityType String? // e.g. EXPENSE, INCOME, ...
  appliedEntityId   String?
  appliedAt         DateTime?
  undoneAt          DateTime?
  undoReason        String?
  correctionCount   Int                 @default(0)
  reviewedAt        DateTime?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  corrections CaptureCorrection[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, appliedAt(sort: Desc)])
  @@index([userId, parseNeedsReview, createdAt(sort: Desc)])
}

// Append-only record of every time a user edited the parser's preview
// before confirming. The OpenAI parser reads the most recent N corrections
// as few-shot examples on subsequent ambiguous parses, so the system gets
// better the more the user uses it.
model CaptureCorrection {
  id                 String              @id @default(cuid())
  userId             String
  quickCaptureId     String
  rawText            String
  originalSource     CaptureParseSource
  originalKind       String?
  originalConfidence Decimal?            @db.Decimal(5, 4)
  originalPayload    Json?
  correctedKind      String?
  correctedPayload   Json?
  confirmed          Boolean             @default(true)
  createdAt          DateTime            @default(now())

  quickCapture QuickCapture @relation(fields: [quickCaptureId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([quickCaptureId])
}
