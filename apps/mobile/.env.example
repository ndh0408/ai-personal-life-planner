# =============================================================================
# apps/mobile — environment example
# Copy to apps/mobile/.env. Expo exposes only EXPO_PUBLIC_* vars to the client.
# NEVER put server secrets (DB URL, AI keys, JWT secrets) here.
# =============================================================================

# Public — bundled into the app
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
EXPO_PUBLIC_APP_ENV=development
