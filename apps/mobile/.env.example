# =============================================================================
# apps/mobile — environment example
# Expo bundles only EXPO_PUBLIC_* vars into the JS. Server secrets MUST NOT
# live here.
# =============================================================================

# Where the API lives. Use your machine's LAN IP for physical devices —
# `localhost` only works on emulators / web.
#   Android emulator:  http://10.0.2.2:3000/api
#   iOS simulator:     http://localhost:3000/api
#   Physical phone:    http://<your-LAN-ip>:3000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# "development" | "staging" | "production" — surfaced in Settings + telemetry
EXPO_PUBLIC_APP_ENV=development
