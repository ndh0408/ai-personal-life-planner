{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lifeos/shared": ["../../packages/shared/src/index.ts"],
      "@lifeos/shared/*": ["../../packages/shared/src/*"],
      "@lifeos/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@lifeos/design-tokens/*": ["../../packages/design-tokens/src/*"],
      "@lifeos/aurora": ["../../packages/aurora/src/index.ts"],
      "@lifeos/aurora/*": ["../../packages/aurora/src/*"],
      "@lifeos/taxonomy": ["../../packages/taxonomy/src/index.ts"],
      "@lifeos/taxonomy/*": ["../../packages/taxonomy/src/*"]
    }
  },
  "include": ["App.tsx", "index.js", "src/**/*", "__tests__/**/*"],
  "exclude": ["node_modules", "android", "ios"]
}
