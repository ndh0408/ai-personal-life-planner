<?xml version="1.0" encoding="utf-8"?>
<!--
  LifeOS AI launcher foreground (round 33). Vector drawable so the
  launcher can rasterise crisply at any density. Mark sits inside the
  centre 80×80 of the 108×108 viewBox so every device mask preserves it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- L stem -->
    <path
        android:fillColor="#C97B4A"
        android:pathData="M36,32 L46,32 A5,5 0 0 1 51,37 L51,71 A5,5 0 0 1 46,76 L36,76 Z"/>

    <!-- O ring (stroked circle approximated as path) -->
    <path
        android:fillColor="#C97B4A"
        android:pathData="M68,37
                          A17,17 0 1 1 67.99,37 Z
                          M68,43
                          A11,11 0 1 0 68,65
                          A11,11 0 1 0 68,43 Z"
        android:fillType="evenOdd"/>

    <!-- Centre dot -->
    <path
        android:fillColor="#C97B4A"
        android:pathData="M68,50.8 A3.2,3.2 0 1 1 67.99,50.8 Z"/>
</vector>
