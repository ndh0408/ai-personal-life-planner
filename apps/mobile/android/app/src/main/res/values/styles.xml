<resources>

    <!-- Base application theme. Used after the splash window is dismissed. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Round 33: explicit window background = canvas, so the brief
             interval between SplashScreen dismissal and the first React
             paint is the same cream as the splash itself — no flash. -->
        <item name="android:windowBackground">@color/splashBackground</item>
        <!-- Round 41: edge-to-edge. Status + nav bars become transparent so
             the warm-dark canvas extends behind them. ScreenContainer adds
             safe-area padding so content stays readable. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Note (round 33): a custom Theme.SplashScreen style would need the
         androidx.core:core-splashscreen library on the gradle classpath
         to resolve windowSplashScreenBackground / windowSplashScreenAnimatedIcon.
         We skip it here to keep the dependency footprint stable — AppTheme
         above already sets windowBackground=splashBackground, which Android
         12+ honours for the cold-start splash with the launcher icon
         centred on it. Re-introduce a proper theme when the splashscreen
         lib lands in a future round. -->

</resources>
