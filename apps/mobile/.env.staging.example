# Staging build target — internal APK via `eas build --profile staging`.
# HTTPS is strongly recommended even in staging so cert behavior matches prod.
# Re-uses the production tunnel hostname by default; if you stand up a separate
# staging tunnel later, point this at e.g. https://staging-api.tothanhthuy.cloud/api.
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_API_BASE_URL=https://api.tothanhthuy.cloud/api
