{
  "name": "@lifeos/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "LifeOS AI — mobile app (React Native + Expo)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean --no-install",
    "build:android:preview": "eas build --platform android --profile preview --non-interactive",
    "build:android:staging": "eas build --platform android --profile staging --non-interactive",
    "build:android:production": "eas build --platform android --profile production --non-interactive",
    "build:ios:simulator": "eas build --platform ios --profile ios-simulator --non-interactive",
    "build:ios:production": "eas build --platform ios --profile production --non-interactive",
    "submit:android": "eas submit --platform android --profile production --latest",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "verify:prod-config": "EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_API_BASE_URL=https://api.tothanhthuy.cloud/api expo config --type public > /dev/null && echo 'OK: production config resolves'",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"(no mobile tests yet)\" && exit 0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@planner/shared": "*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-linear-gradient": "~13.0.2",
    "expo-localization": "~15.0.3",
    "expo-notifications": "~0.28.16",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "i18next": "^23.15.1",
    "react": "18.2.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.2",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.79",
    "eas-cli": "^18.8.1",
    "typescript": "^5.5.4"
  }
}
