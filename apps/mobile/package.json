{
  "name": "@lifeos/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "LifeOS AI — mobile app (React Native + Expo)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean --no-install",
    "build:android:preview": "eas build --platform android --profile preview --non-interactive",
    "build:android:staging": "eas build --platform android --profile staging --non-interactive",
    "build:android:production": "eas build --platform android --profile production --non-interactive",
    "build:ios:simulator": "eas build --platform ios --profile ios-simulator --non-interactive",
    "build:ios:production": "eas build --platform ios --profile production --non-interactive",
    "submit:android": "eas submit --platform android --profile production --latest",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "verify:prod-config": "EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_API_BASE_URL=https://api.tothanhthuy.cloud/api expo config --type public > /dev/null && echo 'OK: production config resolves'",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"(no mobile tests yet)\" && exit 0"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@hookform/resolvers": "^3.9.0",
    "@planner/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.12",
    "expo-av": "^16.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "^55.0.6",
    "expo-linear-gradient": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^23.15.1",
    "react": "19.1.0",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eas-cli": "^18.8.1",
    "typescript": "^5.5.4"
  }
}
