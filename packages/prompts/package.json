{
  "name": "@lifeos/prompts",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned prompt registry for LifeOS AI. Prompts are code: typed inputs, semver, eval suites in tooling/prompts-eval.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
