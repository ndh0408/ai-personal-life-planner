{
  "name": "ai-personal-life-planner",
  "private": true,
  "version": "0.1.0",
  "description": "AI-powered personal life planner — monorepo (mobile + api + shared)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:mobile": "npm run --workspace apps/mobile start",
    "dev:api": "npm run --workspace apps/api start:dev",
    "dev:db": "docker compose -f docker/docker-compose.yml up -d",
    "dev:db:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "npm run --workspace apps/api db:migrate",
    "db:seed": "npm run --workspace apps/api db:seed",
    "db:studio": "npm run --workspace apps/api db:studio",
    "build:shared": "npm run --workspace packages/shared build",
    "build:api": "npm run --workspace apps/api build",
    "build": "npm run build:shared && npm run build:api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
